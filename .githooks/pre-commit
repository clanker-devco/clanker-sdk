#!/bin/sh
# Format and fix staged files with Biome and re-stage them. Bypass with --no-verify.
# A checkout without dependencies installed commits as is.
[ -e node_modules/.bin/biome ] || exit 0
bunx biome check --write --staged --no-errors-on-unmatched || exit 1
git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 -r git add
